# NOVA CART server configuration
DATABASE_URL=mysql://user:password@host:3306/novacart

# Transactional email delivery
# Production: use the SMTP credentials from the NOVA CART SMTP connector.
# Local mock server: SMTP_HOST=127.0.0.1, SMTP_PORT=2525, SMTP_USER=mock,
# SMTP_PASSWORD=mock, SMTP_FROM=security@novacart.local
SMTP_HOST=127.0.0.1
SMTP_PORT=2525
SMTP_USER=mock
SMTP_PASSWORD=mock
SMTP_FROM=security@novacart.local
